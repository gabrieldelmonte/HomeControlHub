// Home Control Hub
//
// schema.prisma
//



generator client {
  provider = "prisma-client-js"
  output   = "./generated/prisma-client"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

//generator erd {
//  provider = "prisma-erd-generator"
//  output   = "./generated/erd-generator.pdf"
//}

enum UserRole {
  ADMIN
  STANDARD_USER
  GUEST
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model User {
  id             String          @id @default(uuid())
  username       String          @unique
  email          String          @unique
  passwordHash   String
  role           UserRole
  devices        Device[]
  notifications  Notification[]  // Relação adicionada aqui
  systemLogs     SystemLog[]     // Logs relacionados ao usuário
  supportTickets SupportTicket[] // Support tickets created by user
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([username])
  @@index([email])
}

model Device {
  id              String     @id @default(uuid())
  name            String
  type            String
  status          Boolean    @default(false)
  description     String?
  location        String
  mqttTopic       String     @unique
  aesKey          String     @unique
  userId          String
  owner           User       @relation(fields: [userId], references: [id])
  commands        Command[]
  automationRules AutomationRule[]
  systemLogs      SystemLog[] // Logs relacionados ao dispositivo
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([name, type])
  @@index([location])
}

model Command {
  id         String   @id @default(uuid())
  name       String
  payload    Json
  deviceId   String
  device     Device   @relation(fields: [deviceId], references: [id])
  executedAt DateTime @default(now())
}

model AutomationRule {
  id             String   @id @default(uuid())
  name           String
  triggerCondition String
  action         Json
  deviceId       String
  device         Device   @relation(fields: [deviceId], references: [id])
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
}

model Notification {
  id        String   @id @default(uuid())
  message   String
  type      String
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model SupportTicket {
  id          String        @id @default(uuid())
  subject     String
  message     String
  status      TicketStatus  @default(OPEN)
  priority    TicketPriority @default(MEDIUM)
  userId      String
  user        User          @relation(fields: [userId], references: [id])
  attachments String[]      @default([]) // Array of file paths/names (legacy)
  attachments2 SupportTicketAttachment[] // New binary file attachments
  adminNotes  String?       // Notes from admin/support team
  resolvedAt  DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([userId, status])
  @@index([status, priority])
  @@index([createdAt])
}

model SupportTicketAttachment {
  id          String        @id @default(uuid())
  filename    String        // Original filename
  contentType String        // MIME type (e.g., "image/jpeg", "application/pdf")
  fileSize    Int           // File size in bytes
  fileData    Bytes         // Actual file binary data
  ticketId    String
  ticket      SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  createdAt   DateTime      @default(now())

  @@index([ticketId])
  @@index([createdAt])
}

model SystemLog {
  id          String   @id @default(uuid())
  type        String   // 'INFO' | 'WARNING' | 'ERROR'
  message     String
  source      String   // 'DEVICE' | 'USER' | 'AUTH' | 'SYSTEM'
  deviceId    String?  // Optional device reference for device-related logs
  device      Device?  @relation(fields: [deviceId], references: [id])
  userId      String?  // Optional user reference for user-related logs
  user        User?    @relation(fields: [userId], references: [id])
  createdAt   DateTime @default(now())
  
  @@index([type, source])
  @@index([deviceId, createdAt])
}
